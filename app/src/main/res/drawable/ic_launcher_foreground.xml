        android:fillColor="#FFFFFF"
        android:pathData="M39,26 L69,26 A13,13 0 0 1 82,39 L82,69 A13,13 0 0 1 69,82 L39,82 A13,13 0 0 1 26,69 L26,39 A13,13 0 0 1 39,26 Z" />

    <!-- 五孔:SVG transform="translate(8.1 8.1) scale(0.85)" -->
