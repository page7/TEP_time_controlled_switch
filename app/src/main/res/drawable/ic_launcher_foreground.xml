            android:fillColor="#10B981"
            android:pathData="M41.5,38.352 A2,2 0 0 1 43.5,40.352 L43.5,49.852 A2,2 0 0 1 41.5,51.852 A2,2 0 0 1 39.5,49.852 L39.5,40.352 A2,2 0 0 1 41.5,38.352 Z" />
