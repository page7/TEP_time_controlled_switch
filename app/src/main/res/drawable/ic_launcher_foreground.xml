            android:pathData="M54,38.352 A2,2 0 0 1 56,40.352 L56,49.852 A2,2 0 0 1 54,51.852 A2,2 0 0 1 52,49.852 L52,40.352 A2,2 0 0 1 54,38.352 Z" />
        <path
            android:fillColor="#10B981"
            android:pathData="M66.5,38.352 A2,2 0 0 1 68.5,40.352 L68.5,49.852 A2,2 0 0 1 66.5,51.852 A2,2 0 0 1 64.5,49.852 L64.5,40.352 A2,2 0 0 1 66.5,38.352 Z" />
        <!-- 下排:45° 斜孔(SVG matrix(0.707107,-0.707107,0.707107,0.707107,-32.868149,48.968778) = rotate(-45) + 平移) -->
