                android:pathData="M41.5,60.25 A2,2 0 0 1 43.5,62.25 L43.5,71.75 A2,2 0 0 1 41.5,73.75 A2,2 0 0 1 39.5,71.75 L39.5,62.25 A2,2 0 0 1 41.5,60.25 Z" />
