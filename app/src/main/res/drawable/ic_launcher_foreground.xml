        <path
            android:fillColor="#0C8B61"
            android:pathData="M44,31 L74,31 A13,13 0 0 1 87,44 L87,74 A13,13 0 0 1 74,87 L44,87 A13,13 0 0 1 31,74 L31,44 A13,13 0 0 1 44,31 Z" />

